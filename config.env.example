# Copy to config.env and fill in your environment. config.env is gitignored.
#   cp config.env.example config.env

# Your name/initials. Prefixes every object created in the Infoblox Portal so
# hosts and services are identifiable in a SHARED tenant (many people use one
# CSP account). VM <your-name>-<vmid>, services <your-name>-<vmid>-dns, etc.
OWNER="CHANGEME"   # <your-name>

# Proxmox host to deploy onto (ssh target, key auth). Use your own login with
# passwordless sudo, e.g. "jsmith@pve1". root@host also works. See README.
PVE="CHANGEME@CHANGEME"

# NIOS-X On-Prem qcow2 downloaded from the Infoblox Portal.
IMG="$HOME/Downloads/NIOS-X_OnPrem_QCOW2_v4.1.12.qcow2"

# Proxmox storage that accepts VM images. Must support thin/sparse volumes
# (a zfspool with `sparse 1`, or thin-LVM). A plain `dir` store usually won't.
POOL=local-zfs

# Bridge for the appliance's single NIC. Needs DHCP + outbound HTTPS/443
# to csp.infoblox.com so the host can register itself.
BRIDGE=vmbr0

# --- Optional: Infoblox minimum spec (smallest 5 kQPS tier). Override if bigger. ---
RAM=4096      # MB   (floor: 4 GB)
CORES=3       #      (floor: 3 vCPU)
DISK=64G      #      (floor: 64 GB — thin, so real usage starts ~2.4 GB)

# Join token from the Infoblox Portal (System > Administration > Join Tokens).
# Ends in .ibjt. This file is gitignored. Leave blank to instead read it from
# ~/.config/niosx/jointoken.
JOINTOKEN=""
