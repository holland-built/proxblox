#!/usr/bin/env bash
# Stub Proxmox. Answers the few reads deploy/list make, records what would have
# been run, and never contacts a real host.
#   STUB_QM_CONFIG   text `qm config` should return ("" = VM does not exist)
#   STUB_QM_STATUS   stopped | running
#   STUB_HALT=1      abort (99) at the first step that would change anything
args="$*"
log() { [ -n "${STUB_LOG:-}" ] && printf '%s\n' "$1" >> "$STUB_LOG"; return 0; }
case "$args" in *" sudo -n "*) log "SSH-SUDO" ;; esac

case "$args" in
  *last_vmid*"printf"*)   log "ALLOCATE"; echo "${STUB_NEXT_VMID:-205}"; exit 0 ;;
  *"qm config"*)
      log "QM-CONFIG"
      cfg=${STUB_QM_CONFIG:-}
      # A real deploy sees no VM at preflight and a VM afterwards. With
      # STUB_QM_CONFIG_AFTER_CREATE the stub does the same, switching once the
      # create script has run.
      if [ -n "${STUB_QM_CONFIG_AFTER_CREATE:-}" ]; then
        if grep -q REMOTE-SCRIPT "${STUB_LOG:-/dev/null}" 2>/dev/null
          then cfg=$STUB_QM_CONFIG_AFTER_CREATE
          else cfg=""
        fi
      fi
      [ -n "$cfg" ] || exit 1
      printf '%s\n' "$cfg"; exit 0 ;;
  *"qm status"*)          log "QM-STATUS"; echo "status: ${STUB_QM_STATUS:-stopped}"; exit 0 ;;
esac

if [ "${STUB_HALT:-0}" = 1 ]; then echo "STUB-HALT: $args" >&2; exit 99; fi

case "$args" in
  *"mkdir -p /var/lib"*)  log "MKDIR"; exit 0 ;;
  *"qm start"*)           log "QM-START"; exit 0 ;;
  *"bash -s"*)            log "REMOTE-SCRIPT"; cat >> "${STUB_CAPTURE:-/dev/null}"; exit 0 ;;
esac
log "SSH: $args"; exit 0
