#!/usr/bin/env bash
# Single entry point for the NIOS-X lab tooling.
#
#   ./niosx deploy   [options]        build a VM, join it to the Portal, start services
#   ./niosx add      <vmid> <name> <services>   add services to an existing host
#   ./niosx teardown <vmid> [options] destroy a node: services, Portal host, VM
#   ./niosx check    [vmid]           on nodes started with deploy --no-wait
#   ./niosx list                      what you have, in Proxmox and the Portal
#   ./niosx test                      run the stubbed test suite
#
# Each subcommand is a thin pass-through; run any of them with --help.
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

usage() {
  cat <<'HELPEOF'
NIOS-X on Proxmox.

  ./niosx deploy [--services dns,ntp] [--vmid N] [--name X] [--no-wait]
        Build a VM, let it register with Infoblox, start the services.
        With no options it prompts for everything.
        --no-wait returns as soon as the VM is running; ./niosx check
        finishes it later.

  ./niosx add <vmid> <host-name> <services>
        Add services to a host that already exists — services it is already
        running are kept. e.g.
        ./niosx add 205 jsmith-205 dhcp

  ./niosx teardown <vmid> [--dry-run]
        Destroy one node: its services, its Portal host, its VM and its
        seed ISO. Start with --dry-run.

  ./niosx check [vmid] [--finish]
        Nodes started with `deploy --no-wait`: have they registered yet, and
        start the services they are waiting for.

  ./niosx list
        Show your VMs and how they line up with the Portal.

  ./niosx test
        Run the test suite (stubbed — touches no host and no tenant).

Setup (once): config.env | ~/.config/niosx/jointoken | terraform/secrets.auto.tfvars
Full docs: README.md
HELPEOF
}

cmd=${1:-}; [ $# -gt 0 ] && shift || true
case "$cmd" in
  deploy)          exec "$HERE/scripts/deploy-niosx.sh" "$@" ;;
  add|add-services) exec "$HERE/scripts/add-services.sh" "$@" ;;
  teardown|destroy) exec "$HERE/scripts/teardown-niosx.sh" "$@" ;;
  check|status)    exec "$HERE/scripts/check-niosx.sh" "$@" ;;
  list)            exec "$HERE/scripts/list-niosx.sh" "$@" ;;
  test)            exec "$HERE/tests/run-all.sh" "$@" ;;
  ""|-h|--help)    usage; exit 0 ;;
  *) echo "!! unknown command: $cmd" >&2; echo >&2; usage >&2; exit 2 ;;
esac
